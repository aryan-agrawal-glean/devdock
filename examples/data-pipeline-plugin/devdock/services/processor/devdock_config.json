{
  "type": "python",
  "dependencies": ["sql", "pubsub", "opensearch", "ingester"],
  "extra_mounts": {
    "../../../": "/app"
  },
  "env": {
    "POSTGRES_HOST": "sql.devdock.local",
    "POSTGRES_PORT": "5432",
    "POSTGRES_DB": "pipeline",
    "POSTGRES_USER": "postgres",
    "POSTGRES_PASSWORD": "localdev",
    "PUBSUB_EMULATOR_HOST": "pubsub.devdock.local:8085",
    "PUBSUB_PROJECT_ID": "local-project",
    "PUBSUB_SUBSCRIPTION": "events-sub",
    "OPENSEARCH_URL": "http://opensearch.devdock.local:9200",
    "OPENSEARCH_INDEX": "events",
    "PYTHONUNBUFFERED": "1"
  },
  "run_commands": [
    "WORKDIR /app"
  ],
  "entrypoint": {
    "script": "entrypoint.sh"
  }
}
