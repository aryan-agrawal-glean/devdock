{
  "type": "python",
  "dependencies": ["sql", "redis", "api"],
  "extra_mounts": {
    "../../../": "/app"
  },
  "env": {
    "DJANGO_DB": "postgresql",
    "POSTGRES_HOST": "sql.devdock.local",
    "POSTGRES_NAME": "postgres",
    "POSTGRES_USER": "postgres",
    "POSTGRES_PASSWORD": "postgres",
    "POSTGRES_PORT": "5432",
    "BROKER_URL": "redis://redis.devdock.local:6379/0",
    "RESULT_BACKEND": "redis://redis.devdock.local:6379/0",
    "SECRET_KEY": "dev-secret-key-change-in-production",
    "C_FORCE_ROOT": "true"
  },
  "run_commands": [
    "WORKDIR /app"
  ],
  "entrypoint": {
    "script": "entrypoint.sh"
  }
}
